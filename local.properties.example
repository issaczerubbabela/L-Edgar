# SheetSync — local.properties template
# Copy this file to local.properties (git-ignored) and fill in your values.

# Android SDK path (auto-set by Android Studio on first project open)
# sdk.dir=C\:\\Users\\YourUsername\\AppData\\Local\\Android\\Sdk

# ─── Debug build: test Apps Script (optional) ────────────────────────────────
# The app uses the URL entered in its Database Setup screen. The debug build
# (installed as "L.Edgar (Debug)" next to the release app) falls back to this
# URL when none has been entered, so development can use a test Sheet instead
# of your real one. Deploy scripts/AppsScript.gs over a separate test Sheet
# (Deploy → New Deployment, Web App, Execute as: Me, Access: Anyone):
# APPS_SCRIPT_URL_DEBUG=https://script.google.com/macros/s/YOUR_TEST_SCRIPT_ID/exec
